# UnitWise / LessonCraft AI Backend Configuration
PORT=3001
NODE_ENV=production

# CORS Configuration: Set to your Vercel frontend URL in production, or * to allow all
CORS_ORIGIN=https://your-unitwise-app.vercel.app

# Storage Configuration: Persistent file-based store location
# In production on Render/Railway with a persistent volume: /var/data
DATA_DIR=./data

# Maximum concurrent active plans per teacher (enforces 3-active-plans rule)
MAX_ACTIVE_PLANS=3

# Primary AI Provider ('gemini' | 'openai' | 'anthropic')
# If omitted or invalid, operates in high-fidelity pedagogical demo mode
AI_PROVIDER=gemini

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Optional alternative providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Authentic Reference Materials & Search Providers (Optional)
REFERENCE_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
