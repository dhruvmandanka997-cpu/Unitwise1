# ==============================================================================
# UnitWise (LessonCraft AI) — Production Environment Configuration
# ==============================================================================
# This template documents all environment variables for local development,
# Vercel frontend deployments, and production backend hosting.
# NEVER commit real API keys, secrets, or .env files containing credentials to Git.
# ==============================================================================

# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Project Settings)
# ==============================================================================
# In Vercel -> Project -> Settings -> Environment Variables:
#
# Production backend API base URL.
# If your backend is deployed on Render/Railway/Fly.io, set this to your backend URL:
# Example: https://unitwise-api.onrender.com/api
# In local development, leave empty to use the Vite proxy (/api -> http://localhost:3001).
VITE_API_BASE_URL=

# ==============================================================================
# 2. BACKEND ENVIRONMENT VARIABLES (Set in Render / Railway / Server Host)
# ==============================================================================
# Server port (Render/Railway/Heroku automatically inject $PORT)
PORT=3001

# Runtime environment (production / development / test)
NODE_ENV=production

# Allowed CORS Origin for production.
# Set to your Vercel URL (e.g., https://unitwise.vercel.app) or comma-separated URLs.
# Set to * to allow all origins.
CORS_ORIGIN=https://your-unitwise-app.vercel.app

# Storage directory for persistent JSON files (plans, tasks, settings) & SQLite directory.db
# In local dev: ./backend/data
# In production on Render/Railway with persistent disk: /var/data
DATA_DIR=./backend/data

# Maximum concurrent active plans per user (enforces the 3-active-plans rule)
MAX_ACTIVE_PLANS=3

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Primary AI provider: 'gemini' | 'openai' | 'anthropic'
AI_PROVIDER=gemini

# Google Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/)
# Note: If no key is provided, the backend operates in high-fidelity pedagogical demo mode.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Optional alternative AI providers:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# Authentic Reference Materials & Search Providers (Optional)
# ------------------------------------------------------------------------------
# Mode: 'auto' (tries Tavily -> Brave -> Google -> Curated Registry Fallback)
REFERENCE_PROVIDER=auto

# Option A: Tavily AI Search (Recommended for academic/educational resources: https://tavily.com)
TAVILY_API_KEY=

# Option B: Brave Search API (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# Option C: Google Programmable Custom Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
