# ==============================================================================
# LessonCraft AI - Unified Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env or root .env)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# AI Provider Configuration (Google Gemini, OpenAI, or Anthropic)
# Default provider is Google Gemini. Operates in high-fidelity demo mode if no key is provided.
AI_PROVIDER=gemini

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Optional alternative AI providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Storage Configuration
# Persistent file-based store location (defaults to ./backend/data)
DATA_DIR=./backend/data

# ------------------------------------------------------------------------------
# Reference Materials Search Retrieval Providers (Server-side only)
# ------------------------------------------------------------------------------
# Set REFERENCE_PROVIDER to 'auto', 'tavily', 'brave', 'google', or 'registry'
REFERENCE_PROVIDER=auto

# Option A: Tavily AI Search (Recommended for academic & educational research: https://tavily.com)
TAVILY_API_KEY=

# Option B: Brave Search API (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# Option C: Google Custom / Programmable Search (https://developers.google.com/custom-search/v1/overview)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env or root .env)
# ------------------------------------------------------------------------------
# Optional: Specify backend API base URL (defaults to Vite proxy /api)
VITE_API_BASE_URL=
