{
  "name": "unitwise",
  "version": "1.0.0",
  "description": "UnitWise - AI Unit & Curriculum Planning Assistant for Teachers",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "server": "npm run dev --workspace=backend",
    "client": "npm run dev --workspace=frontend",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "backend:start": "npm run start --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "frontend:build": "npm run build --workspace=frontend",
    "build": "npm run backend:build && npm run frontend:build",
    "test": "npm run test --workspace=backend",
    "test:backend": "npm run test --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
